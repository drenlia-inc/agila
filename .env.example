# =============================================================================
# Agila — operator secrets & optional overrides
# Copy to `.env` in the project root. Docker Compose substitutes ${VAR} from this
# file into docker-compose-*.yml. The Node server does NOT load this file itself;
# values must reach the container via compose `environment:` (or real process env).
#
# Plan limits (LICENSE_ENABLED, USER_LIMIT, …) and topology stay in compose YAML.
# =============================================================================

# --- Required secrets (referenced from docker-compose-*.yml) ---
JWT_SECRET=change-me-to-a-long-random-string
# Prefer a dedicated key for settings-at-rest (SMTP/OAuth/AI secrets). If unset,
# the server falls back to JWT_SECRET. Rotating either key requires re-entering
# SMTP_PASSWORD, GOOGLE_CLIENT_SECRET, AI_API_KEY, AI_RUNNER_TOKEN,
# and S3_SECRET_ACCESS_KEY in Admin.
SETTINGS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=kanban_password
INSTANCE_TOKEN=change-me-instance-token

# Pro / free compose with kanban-runner — must match app + runner services
RUNNER_TOKEN=kanban-runner-dev-token-change-me

# --- Optional local overrides (uncomment if needed) ---
# ALLOWED_ORIGINS=localhost,127.0.0.1
# ADMIN_SERVICE_URL=https://admin.agila.dev
# TENANT_DOMAIN=agila.dev
# APP_VERSION=0.9-beta
# Media cookie JWT lifetime (default 8h). Shorter than session JWT; client refreshes hourly.
# MEDIA_TOKEN_EXPIRES_IN=8h

# --- Optional managed SMTP for licensed tenants (seeded at tenant init only) ---
# Defaults derive from TENANT_DOMAIN when unset: smtp.{domain}, noreply@{domain}
# MANAGED_SMTP_HOST=smtp.agila.dev
# MANAGED_SMTP_USERNAME=noreply@agila.dev
# MANAGED_SMTP_FROM_EMAIL=noreply@agila.dev
# MANAGED_SMTP_FROM_NAME=Agila
# MANAGED_SMTP_PASSWORD=

# --- Optional platform S3 for licensed / multi-tenant SaaS (seeded at tenant init) ---
# Prefer PLATFORM_S3_*; MANAGED_S3_* is a legacy alias for the same values.
# PLATFORM_S3_BUCKET=
# PLATFORM_S3_REGION=
# PLATFORM_S3_ENDPOINT=
# PLATFORM_S3_ACCESS_KEY_ID=
# PLATFORM_S3_SECRET_ACCESS_KEY=
# PLATFORM_S3_FORCE_PATH_STYLE=false
# PLATFORM_S3_KEY_PREFIX=
# MANAGED_S3_BUCKET=
# MANAGED_S3_REGION=
# MANAGED_S3_ENDPOINT=
# MANAGED_S3_ACCESS_KEY_ID=
# MANAGED_S3_SECRET_ACCESS_KEY=
# MANAGED_S3_FORCE_PATH_STYLE=false
# MANAGED_S3_KEY_PREFIX=
