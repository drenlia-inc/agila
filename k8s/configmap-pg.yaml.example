# TEMPLATE ONLY — copy to the same path without .example and fill secrets.
# The non-.example file is gitignored so real values never enter the repo.
apiVersion: v1
kind: ConfigMap
metadata:
  name: easy-kanban-config-pg
  namespace: easy-kanban-pg
  labels:
    app: easy-kanban
    database: postgresql
data:
  NODE_ENV: "production"
  DOCKER_ENV: "true"
  PORT: "3222"
  VITE_API_URL: "http://localhost:3222"
  DEMO_ENABLED: "false"
  
  # Instance configuration for admin portal access
  INSTANCE_NAME: "easy-kanban-pg"
  # Copy this file to configmap-pg.yaml (gitignored) and replace placeholders,
  # or let deploy-pg.sh generate/preserve tokens at apply time.
  INSTANCE_TOKEN: "INSTANCE_TOKEN_PLACEHOLDER"
  ADMIN_SERVICE_URL: "https://admin.agila.dev"
  
  # Security configuration
  JWT_SECRET: "JWT_SECRET_PLACEHOLDER"
  # CORS / Socket.IO extras — tenants are {id}.agila.dev (example uses generic app)
  ALLOWED_ORIGINS: "localhost,127.0.0.1,app.agila.dev,kanban.agila.dev,admin.agila.dev,agila.dev,auth.agila.dev"
  AUTH_HUB_PUBLIC_URL: "https://auth.agila.dev"
  # Optional extra hub URLs (comma-separated) if ingress uses more than one auth hostname.
  AUTH_HUB_PUBLIC_URLS: ""
  # Only for single-tenant / docker testing. Leave empty on K8s (return host is {tenant}.{TENANT_DOMAIN}).
  AUTH_HUB_RETURN_ORIGIN: ""
  
  # License settings
  LICENSE_ENABLED: "true"
  
  # Application version
  APP_VERSION: "APP_VERSION_PLACEHOLDER"
  
  # Multi-tenant configuration
  MULTI_TENANT: "true"
  TENANT_DOMAIN: "agila.dev"
  STARTUP_TENANT_ID: ""
  
  # PostgreSQL Configuration (replaces SQLite)
  DB_TYPE: "postgresql"
  POSTGRES_HOST: "postgres"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "easykanban"
  POSTGRES_USER: "kanban"
  # Each tenant gets its own pool; size so surge_pods × (tenants × max + ~10) < max_connections
  POSTGRES_POOL_MAX: "8"
  # POSTGRES_PASSWORD is set via Secret (not in ConfigMap for security)
  
  # Real-time updates via PostgreSQL pub/sub
  # PostgreSQL LISTEN/NOTIFY is used for app notifications
  # Redis is still required for Socket.IO session sharing across pods
  REDIS_URL: "redis://redis:6379"

  # Shared agent runner (platform-managed; Admin UI is read-only when MULTI_TENANT=true)
  # RUNNER_TOKEN is injected from Secret kanban-runner-secret (not stored here)
  AI_RUNNER_URL: "http://kanban-runner:8080"
  AI_CALLBACK_BASE_URL: "http://easy-kanban-service:3222"

  # Platform-managed S3 (optional). When MANAGED_S3_BUCKET is non-empty and
  # LICENSE_ENABLED=true, new tenants get STORAGE_MANAGED=true + S3 backend.
  # Credentials come from Secret easy-kanban-managed-s3 (not stored here).
  # Object keys use tenants/{tenantId}/ unless MANAGED_S3_KEY_PREFIX is set.
  # SETTINGS_ENCRYPTION_KEY encrypts S3_SECRET_ACCESS_KEY in the tenant settings table.
  MANAGED_S3_BUCKET: ""
  MANAGED_S3_REGION: ""
  MANAGED_S3_ENDPOINT: ""
  MANAGED_S3_FORCE_PATH_STYLE: "false"
  MANAGED_S3_KEY_PREFIX: ""
